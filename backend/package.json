{
  "name": "eco-bot-builders-backend",
  "version": "1.0.0",
  "description": "Real-time backend for Eco-Bot Builders STEM game",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test test/*.test.js",
    "check": "node -e \"require('fs').readdirSync('.',{recursive:true}).filter(f=>f.endsWith('.js')&&!f.startsWith('node_modules')).forEach(f=>require('child_process').execFileSync(process.execPath,['--check',f]))\" && echo syntax-ok"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "json2csv": "^6.0.0-alpha.2",
    "mongoose": "^7.3.1",
    "pdfkit": "^0.13.0",
    "qrcode": "^1.5.3",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
