# HTTP port for Express + Socket.io
PORT=3001
# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/eco-bot-builders
# Base URL students open to join (encoded into the room QR code)
CLIENT_JOIN_URL=http://localhost:5173/join
# Comma-separated list of allowed CORS origins ("*" = any)
CORS_ORIGIN=*
