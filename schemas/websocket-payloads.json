{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://eco-bot-builders.example.org/schemas/websocket-payloads.json",
  "title": "Eco-Bot Builders - Socket.io Event Payloads",
  "description": "JSON Schema (Draft-07) definitions for every Socket.io event exchanged between the Unity student client, the React teacher dashboard and the Node.js backend.",
  "version": "1.0.0",
  "transport": {
    "library": "socket.io v4",
    "defaultUrl": "http://localhost:3001",
    "path": "/socket.io",
    "rooms": {
      "room:<PIN>": "All students and the teacher of a classroom.",
      "teacher:<PIN>": "Teacher dashboard sockets only.",
      "student:<studentId>": "A single student's socket(s)."
    },
    "acknowledgements": "Every client->server event accepts an optional trailing ack callback which receives { ok: boolean, error?: string, ... }.",
    "authorisation": "Teacher events are accepted only from the socket that sent teacher:join for that roomPin. Student game events are accepted only from the socket that joined as that studentId in that roomPin."
  },
  "definitions": {
    "roomPin": {
      "type": "string",
      "pattern": "^\\d{4}$",
      "description": "4-digit classroom PIN (string so leading zeros are preserved).",
      "examples": [
        "0420"
      ]
    },
    "studentId": {
      "type": "string",
      "format": "uuid",
      "description": "Server-issued UUID v4 returned in the student:joined event."
    },
    "levelId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10,
      "description": "Level number (1-10)."
    },
    "personName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Display name; control characters and < > are stripped server-side, whitespace collapsed, truncated to 40 chars."
    },
    "isoTimestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp generated by the server."
    },
    "competencyScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Normalised competency score; out-of-range values are clamped server-side."
    },
    "cosmeticId": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,40}$",
      "description": "Cosmetic slug understood by the Unity client.",
      "examples": [
        "leaf_antenna",
        "solar_visor",
        "golden_gear_crown"
      ]
    },
    "ackResponse": {
      "type": "object",
      "description": "Optional Socket.io acknowledgement callback payload returned for every client->server event.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "description": "Human-readable error when ok=false."
        }
      },
      "required": [
        "ok"
      ],
      "additionalProperties": true
    },
    "rosterStudent": {
      "type": "object",
      "properties": {
        "studentId": {
          "$ref": "#/definitions/studentId"
        },
        "name": {
          "$ref": "#/definitions/personName"
        },
        "currentLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "cleanTokensBalance": {
          "type": "integer",
          "minimum": 0
        },
        "unlockedCosmetics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cosmeticId"
          }
        },
        "joinedAt": {
          "$ref": "#/definitions/isoTimestamp"
        },
        "lastSeen": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "isConnected": {
          "type": "boolean"
        }
      },
      "required": [
        "studentId",
        "name",
        "currentLevel",
        "cleanTokensBalance",
        "unlockedCosmetics",
        "isConnected"
      ]
    },
    "telemetry": {
      "type": "object",
      "description": "Learning telemetry captured by the Unity client for one level attempt.",
      "properties": {
        "retriesCount": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "timeSpentSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 86400,
          "description": "Values above 86400 (24 h) are capped."
        },
        "subroutinesUsed": {
          "type": "boolean",
          "default": false
        },
        "completedAt": {
          "$ref": "#/definitions/isoTimestamp"
        },
        "stemCompetencyScores": {
          "type": "object",
          "properties": {
            "computationalThinking": {
              "$ref": "#/definitions/competencyScore"
            },
            "systemicEngineering": {
              "$ref": "#/definitions/competencyScore"
            },
            "mathModeling": {
              "$ref": "#/definitions/competencyScore"
            },
            "persistence": {
              "$ref": "#/definitions/competencyScore"
            }
          },
          "additionalProperties": false
        },
        "blockProgramSnapshot": {
          "type": "array",
          "maxItems": 500,
          "description": "Serialized block program. See unity-block-program-schema.json.",
          "items": {
            "$ref": "unity-block-program-schema.json#/definitions/block"
          }
        }
      },
      "required": [
        "retriesCount",
        "timeSpentSeconds",
        "subroutinesUsed",
        "stemCompetencyScores",
        "blockProgramSnapshot"
      ]
    }
  },
  "events": {
    "clientToServer": {
      "student": {
        "student:join": {
          "title": "student:join",
          "description": "Student joins a classroom. Re-joining with the same name (or with a previously issued studentId) resumes the existing record. Server replies with 'student:joined' (or 'student:join_error') and broadcasts 'roster:updated' to the teacher.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentName": {
              "$ref": "#/definitions/personName"
            },
            "studentId": {
              "type": "string",
              "format": "uuid",
              "description": "Optional: previously issued id, used to resume on reconnect."
            }
          },
          "required": [
            "roomPin",
            "studentName"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentName": "Maya"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "studentId": "uuid",
              "studentName": "string",
              "currentLevel": "integer",
              "cleanTokensBalance": "integer",
              "unlockedCosmetics": "string[]",
              "isPaused": "boolean",
              "isMuted": "boolean",
              "communityProgress": "integer",
              "communityGoal": 1000
            }
          }
        },
        "student:token_earned": {
          "title": "student:token_earned",
          "description": "Student earned Clean Tokens. Server increments the student's balance and the class community meter, then broadcasts TOKEN_EARNED and COMMUNITY_PROGRESS.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Tokens awarded (anti-abuse cap: 100 per event)."
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            }
          },
          "required": [
            "roomPin",
            "studentId",
            "amount",
            "levelId"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "amount": 25,
              "levelId": 3
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "newBalance": "integer"
            }
          }
        },
        "student:level_completed": {
          "title": "student:level_completed",
          "description": "Student completed a level. Server stores a LevelTelemetry document, unlocks the next level, awards the level cosmetic on first completion, then broadcasts LEVEL_COMPLETED (room), COSMETIC_UNLOCKED (student only) and roster:updated (teacher).",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            },
            "telemetry": {
              "$ref": "#/definitions/telemetry"
            }
          },
          "required": [
            "roomPin",
            "studentId",
            "levelId",
            "telemetry"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "levelId": 3,
              "telemetry": {
                "retriesCount": 2,
                "timeSpentSeconds": 184.5,
                "subroutinesUsed": false,
                "stemCompetencyScores": {
                  "computationalThinking": 0.8,
                  "systemicEngineering": 0.65,
                  "mathModeling": 0.7,
                  "persistence": 0.9
                },
                "blockProgramSnapshot": [
                  {
                    "blockId": "b1",
                    "blockType": "LOOP_REPEAT",
                    "parameter": 3,
                    "children": [
                      {
                        "blockId": "b2",
                        "blockType": "ACTION_MOVE",
                        "parameter": 1,
                        "children": []
                      }
                    ]
                  }
                ]
              }
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "telemetryId": "string (ObjectId)",
              "currentLevel": "integer",
              "cosmeticUnlocked": "string|null"
            }
          },
          "x-validation-notes": "Server-side: retriesCount defaults to 0 if omitted, scores are clamped to [0,1], snapshot limited to 500 blocks. The schema marks all telemetry fields required as the Unity client contract."
        },
        "student:energy_contributed": {
          "title": "student:energy_contributed",
          "description": "Student's machine generated renewable energy (e.g. turbine, water wheel). Broadcast as ENERGY_CONTRIBUTED for the classroom HUD.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "kw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000,
              "description": "Kilowatts contributed (cap: 1000 per event)."
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            }
          },
          "required": [
            "roomPin",
            "studentId",
            "kw",
            "levelId"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "kw": 12.5,
              "levelId": 4
            }
          ],
          "x-ack": {
            "success": {
              "ok": true
            }
          },
          "x-validation-notes": "levelId is optional server-side (broadcast as null when omitted) but required by the client contract."
        },
        "student:stuck_alert": {
          "title": "student:stuck_alert",
          "description": "Raised by the Unity HintSystem when a student exceeds the retry threshold. Forwarded to the teacher room only as STUCK_ALERT.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            },
            "retriesCount": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "roomPin",
            "studentId",
            "levelId",
            "retriesCount"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "levelId": 6,
              "retriesCount": 5
            }
          ],
          "x-ack": {
            "success": {
              "ok": true
            }
          }
        }
      },
      "teacher": {
        "teacher:join": {
          "title": "teacher:join",
          "description": "Teacher opens/claims a classroom (upsert). The server replies with 'teacher:joined' containing the full classroom state and roster.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "teacherName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Defaults to 'Teacher' when empty."
            }
          },
          "required": [
            "roomPin",
            "teacherName"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "teacherName": "Ms. Rivera"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "classroom": "ClassroomState (see teacher:joined)"
            }
          }
        },
        "teacher:pause_class": {
          "title": "teacher:pause_class",
          "description": "Freeze gameplay for every student. Only the teacher socket that joined this room is authorised. Broadcasts 'class:paused' to the whole room.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            }
          },
          "required": [
            "roomPin"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "isPaused": "boolean",
              "isMuted": "boolean"
            }
          }
        },
        "teacher:resume_class": {
          "title": "teacher:resume_class",
          "description": "Resume gameplay. Only the teacher socket that joined this room is authorised. Broadcasts 'class:resumed' to the whole room.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            }
          },
          "required": [
            "roomPin"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "isPaused": "boolean",
              "isMuted": "boolean"
            }
          }
        },
        "teacher:mute_audio": {
          "title": "teacher:mute_audio",
          "description": "Mute adaptive game audio on every client. Only the teacher socket that joined this room is authorised. Broadcasts 'audio:mute' to the whole room.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            }
          },
          "required": [
            "roomPin"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "isPaused": "boolean",
              "isMuted": "boolean"
            }
          }
        },
        "teacher:unmute_audio": {
          "title": "teacher:unmute_audio",
          "description": "Restore game audio. Only the teacher socket that joined this room is authorised. Broadcasts 'audio:unmute' to the whole room.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            }
          },
          "required": [
            "roomPin"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true,
              "isPaused": "boolean",
              "isMuted": "boolean"
            }
          }
        },
        "teacher:flag_student": {
          "title": "teacher:flag_student",
          "description": "Flag a student for attention. Broadcast as 'student:flagged' to all teacher dashboards in the room.",
          "x-direction": "client->server",
          "x-audience": "server",
          "type": "object",
          "properties": {
            "roomPin": {
              "$ref": "#/definitions/roomPin"
            },
            "studentId": {
              "$ref": "#/definitions/studentId"
            }
          },
          "required": [
            "roomPin",
            "studentId"
          ],
          "additionalProperties": false,
          "examples": [
            {
              "roomPin": "0420",
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70"
            }
          ],
          "x-ack": {
            "success": {
              "ok": true
            }
          }
        }
      }
    },
    "serverToClient": {
      "broadcast": {
        "TOKEN_EARNED": {
          "title": "TOKEN_EARNED",
          "description": "A student earned Clean Tokens.",
          "x-direction": "server->client",
          "x-audience": "room:<PIN> (students + teacher)",
          "type": "object",
          "properties": {
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "studentName": {
              "$ref": "#/definitions/personName"
            },
            "amount": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            },
            "newBalance": {
              "type": "integer",
              "minimum": 0,
              "description": "Student's balance after this award."
            },
            "communityTokens": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "description": "Class-wide cumulative tokens after this award."
            }
          },
          "required": [
            "studentId",
            "studentName",
            "amount",
            "levelId",
            "newBalance",
            "communityTokens"
          ],
          "additionalProperties": true,
          "examples": [
            {
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "studentName": "Maya",
              "amount": 25,
              "levelId": 3,
              "newBalance": 140,
              "communityTokens": 615
            }
          ]
        },
        "LEVEL_COMPLETED": {
          "title": "LEVEL_COMPLETED",
          "description": "A student completed a level.",
          "x-direction": "server->client",
          "x-audience": "room:<PIN> (students + teacher)",
          "type": "object",
          "properties": {
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "studentName": {
              "$ref": "#/definitions/personName"
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            },
            "cosmeticUnlocked": {
              "type": [
                "string",
                "null"
              ],
              "description": "Cosmetic slug awarded on first completion, otherwise null."
            },
            "currentLevel": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Highest level now unlocked (extension field)."
            },
            "gameCompleted": {
              "type": "boolean",
              "description": "True when level 10 was completed (extension field)."
            }
          },
          "required": [
            "studentId",
            "studentName",
            "levelId",
            "cosmeticUnlocked"
          ],
          "additionalProperties": true,
          "examples": [
            {
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "studentName": "Maya",
              "levelId": 3,
              "cosmeticUnlocked": "water_wheel_wheels",
              "currentLevel": 4,
              "gameCompleted": false
            }
          ]
        },
        "ENERGY_CONTRIBUTED": {
          "title": "ENERGY_CONTRIBUTED",
          "description": "A student's machine contributed renewable energy.",
          "x-direction": "server->client",
          "x-audience": "room:<PIN> (students + teacher)",
          "type": "object",
          "properties": {
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "studentName": {
              "$ref": "#/definitions/personName"
            },
            "kw": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1000
            },
            "levelId": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "studentId",
            "studentName",
            "kw",
            "levelId"
          ],
          "additionalProperties": true,
          "examples": [
            {
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "studentName": "Maya",
              "kw": 12.5,
              "levelId": 4
            }
          ]
        },
        "STUCK_ALERT": {
          "title": "STUCK_ALERT",
          "description": "Intervention alert: a student appears stuck on a level.",
          "x-direction": "server->client",
          "x-audience": "teacher:<PIN> (teacher only)",
          "type": "object",
          "properties": {
            "studentId": {
              "$ref": "#/definitions/studentId"
            },
            "studentName": {
              "$ref": "#/definitions/personName"
            },
            "levelId": {
              "$ref": "#/definitions/levelId"
            },
            "retriesCount": {
              "type": "integer",
              "minimum": 0
            },
            "timestamp": {
              "$ref": "#/definitions/isoTimestamp"
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "description": "Legacy alias of timestamp (same value)."
            }
          },
          "required": [
            "studentId",
            "studentName",
            "levelId",
            "retriesCount",
            "timestamp"
          ],
          "additionalProperties": true,
          "examples": [
            {
              "studentId": "3f1c2a9e-8b7d-4e6f-9a10-2b3c4d5e6f70",
              "studentName": "Leo",
              "levelId": 6,
              "retriesCount": 5,
              "timestamp": "2026-10-19T14:05:31.000Z",
              "at": "2026-10-19T14:05:31.000Z"
            }
          ]
        },
        "COMMUNITY_PROGRESS": {
          "title": "COMMUNITY_PROGRESS",
          "description": "Class-wide 'power the town' meter. Emitted after every TOKEN_EARNED.",
          "x-direction": "server->client",
          "x-audience": "room:<PIN> (students + teacher)",
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "goal": {
              "type": "integer",
              "const": 1000
            },
            "percentage": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "round(tokens/goal*100), capped at 100."
            },
            "communityProgress": {
              "type": "integer",
              "minimum": 0,
              "description": "Legacy alias of tokens."
            },
            "communityGoal": {
              "type": "integer",
              "description": "Legacy alias of goal."
            },
            "percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Legacy alias of percentage."
            }
          },
          "required": [
            "tokens",
            "goal",
            "percentage"
          ],
          "additionalProperties": true,
